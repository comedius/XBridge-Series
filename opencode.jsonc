{
  "$schema": "https://opencode.ai/config.json",

  "default_agent": "coordinator",

  // Relative to the project checkout; new worktrees stay beside the project on the same drive.
  "worktree": {
    "directory": "../worktrees"
  },

  "instructions": [
    "docs/AGENT_WORKFLOW.md"
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "cmake --version", "effect": "allow" },
        { "action": "shell", "resource": "ctest --version", "effect": "allow" },
        { "action": "shell", "resource": "cmake --preset windows-debug", "effect": "allow" },
	{ "action": "shell", "resource": "cmake --fresh --preset windows-debug", "effect": "allow" },
        { "action": "shell", "resource": "cmake --build --preset windows-debug", "effect": "allow" },
        { "action": "shell", "resource": "cmake --build --preset windows-debug --config Debug", "effect": "allow" },
        { "action": "shell", "resource": "ctest --test-dir build/windows-debug -C Debug --output-on-failure", "effect": "allow" },
        { "action": "shell", "resource": "ctest --test-dir \"build/windows-debug\" -C Debug --output-on-failure", "effect": "allow" },
        { "action": "shell", "resource": "cmake --preset ninja-debug", "effect": "allow" },
        { "action": "shell", "resource": "cmake --build --preset ninja-debug", "effect": "allow" },
        { "action": "shell", "resource": "ctest --preset ninja-debug --output-on-failure", "effect": "allow" }
      ]
    },
    "compaction": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "allow" }
      ]
    },
    "summary": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "title": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    }
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "*", "effect": "ask" },

    // Exact read-only Git commands only; no safe.directory wildcard allowances.
    { "action": "shell", "resource": "git status --porcelain=v1 --untracked-files=all", "effect": "allow" },
    { "action": "shell", "resource": "git status --short --branch", "effect": "allow" },
    { "action": "shell", "resource": "git diff --cached --name-only", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },

    // Exact configure/build/test commands only; no trailing '*' wildcards.
    { "action": "shell", "resource": "cmake --version", "effect": "allow" },
    { "action": "shell", "resource": "ctest --version", "effect": "allow" },
    { "action": "shell", "resource": "cmake --preset windows-debug", "effect": "allow" },
    { "action": "shell", "resource": "cmake --build --preset windows-debug", "effect": "allow" },
    { "action": "shell", "resource": "cmake --fresh --preset windows-debug", "effect": "allow" },
    { "action": "shell", "resource": "Copy-Item build/windows-debug/CMakeCache.txt .owner-patch-backup/windows-debug-CMakeCache.txt", "effect": "allow" },
    { "action": "shell", "resource": "Copy-Item build/ninja-debug/CMakeCache.txt .owner-patch-backup/ninja-debug-CMakeCache.txt", "effect": "allow" },
    { "action": "shell", "resource": "cmake --build --preset windows-debug --config Debug", "effect": "allow" },
    { "action": "shell", "resource": "ctest --test-dir build/windows-debug -C Debug --output-on-failure", "effect": "allow" },
    { "action": "shell", "resource": "ctest --test-dir \"build/windows-debug\" -C Debug --output-on-failure", "effect": "allow" },
    { "action": "shell", "resource": "cmake --preset ninja-debug", "effect": "allow" },
    { "action": "shell", "resource": "cmake --build --preset ninja-debug", "effect": "allow" },
    { "action": "shell", "resource": "ctest --preset ninja-debug --output-on-failure", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "git merge *", "effect": "allow" },
    // GitHub CLI: read-only PR inspection plus two exact owner-authorized PR-17 actions.
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' auth status", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' repo view *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr view *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr list *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr checks *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr diff *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr status", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr ready 17", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr merge 17 --merge", "effect": "allow" },
    // XB-NEXT-DEVELOPMENT-02: narrow publication rights for this repository and feature branch only.
    { "action": "shell", "resource": "git rev-parse origin/main", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr create --repo comedius/XBridge-Series --base main --head feature/xb-next-development-02 *", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr ready * --repo comedius/XBridge-Series", "effect": "allow" },
    { "action": "shell", "resource": "& 'C:\\Program Files\\GitHub CLI\\gh.exe' pr merge * --merge --repo comedius/XBridge-Series", "effect": "allow" },
    // Read-only fetch rights; branch switching stays hard-denied.
    { "action": "shell", "resource": "git fetch origin", "effect": "allow" },
    { "action": "shell", "resource": "git fetch origin architecture/guest-address-space-foundation", "effect": "allow" },

    { "action": "shell", "resource": "opencode --version*", "effect": "allow" },
    { "action": "shell", "resource": "opencode -v*", "effect": "allow" },
    { "action": "shell", "resource": "opencode models*", "effect": "allow" },
    { "action": "shell", "resource": "opencode api get *", "effect": "allow" },
    { "action": "shell", "resource": "opencode debug paths*", "effect": "allow" },
    { "action": "shell", "resource": "opencode mcp list*", "effect": "allow" },
    { "action": "shell", "resource": "opencode run *", "effect": "allow" },

    { "action": "question", "resource": "*", "effect": "ask" },
    { "action": "subagent", "resource": "architect", "effect": "allow" },
    { "action": "subagent", "resource": "developer", "effect": "allow" },
    { "action": "subagent", "resource": "tester", "effect": "allow" },
    { "action": "subagent", "resource": "reviewer", "effect": "allow" },
    { "action": "subagent", "resource": "researcher", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },

    { "action": "edit", "resource": ".git/**", "effect": "deny" },
    { "action": "edit", "resource": "**/.git/**", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "ask" },
    { "action": "edit", "resource": "docs/DECISIONS.md", "effect": "ask" },
    { "action": "edit", "resource": "docs/ARCHITECTURE.md", "effect": "ask" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "ask" },
    { "action": "edit", "resource": ".opencode/**", "effect": "ask" },

    // RV-P1-C3: suppress mutating Code Mode tool identities in OpenCode 2.4.1.
    // Source-derived action names use underscores; runtime behavior is not locally verified.
    { "action": "automation_create", "resource": "*", "effect": "deny" },
    { "action": "automation_delete", "resource": "*", "effect": "deny" },
    { "action": "opencode_session_move", "resource": "*", "effect": "deny" },
    { "action": "opencode_worktree_create", "resource": "*", "effect": "deny" }
  ],

  "policies": [
    { "action": "tool.use", "resource": "shell:git rebase *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git switch *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git restore *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git revert *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git cherry-pick *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git pull *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git tag *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git worktree *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git config --global *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cmake --install *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cmake --build * --target install*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Remove-Item *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:del *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Move-Item *", "effect": "deny" },

    { "action": "tool.use", "resource": "read:.git/**", "effect": "deny" },
    { "action": "tool.use", "resource": "read:**/.git/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.git/**", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:**/.git/**", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    // Mirrors `read:*.env.*`. Whole-value `*` spans `/`; this also denies `.env.example` (side effect).
    // Pattern semantics are owner-documented; no runtime behavior is claimed as tested here.
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" }
  ]
}
